# Canonical app URL, used for auth email redirect links
NEXT_PUBLIC_SITE_URL=

# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage bucket for uploaded images (optional — falls back to placeholders if unset)
SUPABASE_STORAGE_BUCKET=

# Prisma / Postgres (Project Settings > Database)
DATABASE_URL=      # pooled connection string (pgbouncer), used at runtime
DIRECT_URL=        # direct connection string, used for migrations
